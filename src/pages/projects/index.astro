---
import { getCollection } from "astro:content";
import SectionHeading from "../../components/SectionHeading.astro";
import WorkIndex from "../../components/WorkIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { requiredEntry } from "../../lib/data";

const { data: experience } = await requiredEntry("experienceData", "experience");
const work = await getCollection("work", ({ data }) => !data.draft);
const publications = await getCollection("publications", ({ data }) => !data.draft);
const selectedWork = [...work, ...publications].sort(
  (left, right) => right.data.year - left.data.year,
);
---

<BaseLayout
  title="Work"
  description="Experience, projects, reports, tools, and applied research by Andrés Nigenda."
>
  <header class="page-intro">
    <p class="eyebrow">Work</p>
    <h1>Experience and selected work</h1>
    <p>A selection of work using data science, AI, and program evaluation to answer questions in education and public policy.</p>
  </header>

  <section class="content-section" aria-labelledby="experience">
    <SectionHeading number="01" title="Experience" id="experience" />
    <div class="experience-list">
      {experience.map((item) => (
        <article class="experience-row">
          <div>
            <p class="entry-kicker">{item.period}</p>
            <p>{item.organization}</p>
            {item.teams && <p class="work-meta">{item.teams.join(" · ")}</p>}
          </div>
          <div>
            <h2>{item.role}</h2>
            <p>{item.summary}</p>
            <ul>
              {item.details.map((detail) => <li>{detail}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="content-section" aria-labelledby="selected-projects">
    <SectionHeading number="02" title="Selected projects" id="selected-projects" />
    <WorkIndex entries={selectedWork} headingLevel="h2" />
  </section>
</BaseLayout>
